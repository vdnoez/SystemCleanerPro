{
  "version": "1.0",
  "_comment": "Diese Datei steuert was der Cleaner scannt. Änderungen hier sind SOFORT in der App aktiv, KEIN EXE-Neubau nötig!",

  "windows_temp_dirs": [
    "%TEMP%",
    "%LOCALAPPDATA%\\Temp",
    "%WINDIR%\\Temp",
    "%LOCALAPPDATA%\\Microsoft\\Windows\\INetCache",
    "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer"
  ],

  "windows_temp_extensions": [
    ".tmp", ".log", ".cache", ".dmp", ".old", ".bak"
  ],

  "dev_temp_patterns": [
    "node_modules",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    "target",
    "build",
    "dist",
    ".gradle",
    ".next",
    ".nuxt",
    ".parcel-cache",
    ".turbo",
    "coverage",
    ".cache",
    "venv",
    ".venv",
    "env"
  ],

  "dev_temp_whitelist": [
    "System32",
    "Windows",
    "Program Files",
    "Program Files (x86)",
    "AppData\\Roaming"
  ],

  "max_scan_depth": 6,
  "min_size_to_show_mb": 1
}